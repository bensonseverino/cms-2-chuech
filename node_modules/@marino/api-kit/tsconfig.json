{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    /* DOM supplies Request/Response/Headers/crypto/URL; see src/types.ts. */
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    /* Load no ambient @types, so no unrelated global set can leak in. */
    "types": []
  },
  "include": ["src", "../content-schema/src"]
}
